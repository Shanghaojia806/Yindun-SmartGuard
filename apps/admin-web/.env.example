# 管理后台环境变量示例
# 复制为 .env.local 后按本地环境修改（.env.local 已被 .gitignore 排除）

# 业务接口地址；留空时使用同源相对路径（由 Vite dev server 代理到 127.0.0.1:8000）
VITE_API_BASE_URL=/api/v1

# 页面标题（可选）
VITE_APP_TITLE=银盾智鉴 · 管理后台

# 是否使用 Mock Adapter：
# - false（P11-R 默认）：走 VITE_API_BASE_URL 指向的真实 FastAPI，任务由 Python Worker 执行；
# - true：本地演示模式，所有训练任务标记为模拟任务，不连接真实执行器。
VITE_USE_MOCK=false

# Mock 请求模拟延迟（毫秒），仅在 VITE_USE_MOCK=true 时生效
VITE_MOCK_LATENCY_MS=260
