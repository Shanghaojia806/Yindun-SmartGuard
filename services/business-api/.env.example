# P11-R 训练业务后端环境变量示例
# 复制为 .env（已被 .gitignore 排除）后按本地环境修改；禁止提交真实 Token 与密钥。

# SQLite 本地开发库路径；生产部署改为 PostgreSQL，例如：
# P11R_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/yindun
P11R_DATABASE_URL=sqlite:///services/business-api/data/p11r.db

# Worker 内部回调 Token（必填，且必须与 ml/training 保持一致，绝不能出现在前端）
P11R_WORKER_TOKEN=dev-worker-token-change-me

# 管理端 Bearer Token；留空表示本地开发不校验
P11R_ADMIN_TOKEN=

# 任务租约秒数：Worker 必须在该时间内续约
P11R_WORKER_LEASE_SECONDS=120

# P12：Ed25519 公钥路径（仅公钥可入库；私钥必须留在 Worker 环境变量或密钥文件中）
P11R_ED25519_PUBLIC_KEY_PATH=ml/training/keys/dev_ed25519_public.pem

# P12：具备模型审核 / 发布权限的角色
P11R_MODEL_RELEASE_ROLES=系统管理员,发布管理员

# CORS 允许来源（Vite 开发服务器）
P11R_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5175,http://localhost:5173

P11R_LOG_LEVEL=INFO
